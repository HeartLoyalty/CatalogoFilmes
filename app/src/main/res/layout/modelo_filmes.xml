<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modelCardMovies"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/modelImgMovies"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:scaleType="centerCrop"
            android:src="#000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modelTittleMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tittle"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardSubtittle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sinopse:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelContentMovies"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_margin="5dp"
                android:text="Content"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp">

                <Button
                    android:id="@+id/btnAssMovie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E20B0B"
                    android:text="Assistir"
                    android:textColor="#000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="30dp" />

                <Button
                    android:id="@+id/btnVmMovie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#0B61E2"
                    android:text="Ver Mais"
                    android:textColor="#000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="15dp"
                    />
            </LinearLayout>


        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>